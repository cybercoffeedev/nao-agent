{
    "name": "nao-agent",
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],
    "service": "dev",
    "runServices": [
        "dev"
    ],
    "workspaceFolder": "/workspace/nao-agent",
    "shutdownAction": "stopCompose",
    "features": {
        "ghcr.io/devcontainers/features/node:2": {
            "version": "lts"
        }
    },
    "postCreateCommand": "npm install -g @opencode/cli@2.2.6",
    "forwardPorts": [
        4096
    ],
    "portsAttributes": {
        "4096": {
            "label": "OpenCode Web",
            "onAutoForward": "openBrowser"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": [
                    "tests"
                ]
            }
        }
    }
}
